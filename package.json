{
  "name": "agent-council",
  "version": "0.1.2",
  "description": "Multi-model AI council CLI that provides consensus-driven decisions using Claude, Codex, and Gemini",
  "type": "module",
  "main": "./dist/lib.js",
  "types": "./dist/lib.d.ts",
  "bin": {
    "agent-council": "./dist/index.js",
    "llm-router-mcp": "./dist/mcp/server.js"
  },
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.js",
      "require": "./dist/lib.js"
    },
    "./cli": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "router-config.json"
  ],
  "keywords": [
    "ai",
    "council",
    "multi-model",
    "consensus",
    "claude",
    "codex",
    "gemini",
    "kimi",
    "moonshot",
    "llm",
    "cli",
    "mcp"
  ],
  "author": "Lukin <mylukin@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bladehstream/agent-council.git"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc && chmod +x dist/index.js dist/mcp/server.js",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "test": "node tests/test-runner.mjs && node tests/test-model-config.mjs",
    "test:unit": "node tests/test-runner.mjs",
    "test:config": "node tests/test-model-config.mjs",
    "test:pipeline": "node tests/test-pipeline.mjs",
    "test:real-world": "node tests/test-real-world.mjs",
    "test:all": "node tests/test-runner.mjs && node tests/test-model-config.mjs && node tests/test-pipeline.mjs && node tests/test-real-world.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.97.1",
    "@google/genai": "^2.4.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chalk": "^5.3.0",
    "openai": "^6.38.0",
    "yargs": "^17.7.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "@types/yargs": "^17.0.33",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
